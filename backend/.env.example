# Server
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=your_database_name_here

# JWT — change to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Encrypts secrets stored in the DB (e.g. the Konnect credentials entered on the
# admin Payment Settings page). 32-byte key as hex (generate with:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Optional — if unset, a key is derived from JWT_SECRET instead. Set it explicitly
# in production so rotating JWT_SECRET doesn't also invalidate stored payment credentials.
ENCRYPTION_KEY=

# Email notifications (optional — leave empty to disable). Used for order
# confirmations, status updates, payment receipts, and staff "new order" alerts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password

# Inbox that receives "new order" / staff alert emails. Optional — falls back
# to SMTP_USER (the same account emails are sent from) if unset.
NOTIFY_EMAIL=

# AI Chatbot — Gemini (optional — leave empty to use rule-based fallback)
GEMINI_API_KEY=

# URLs — used to build links in emails and payment redirects
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Konnect payment gateway (Tunisia) — the API base URL only. The API key and
# wallet ID are no longer read from here: each business owner enters their own
# in the admin "Payment Settings" page, stored encrypted in the DB (see
# ENCRYPTION_KEY above). Switch this to the production URL when going live:
# https://api.konnect.network/api/v2 (sandbox: https://api.preprod.konnect.network/api/v2)
KONNECT_BASE_URL=https://api.preprod.konnect.network/api/v2
