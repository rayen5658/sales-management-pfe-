# Used by docker-compose.yml itself (NOT the same file as backend/.env).
# DB_USER / DB_PASSWORD / DB_NAME here create the Postgres container —
# they must match the values in backend/.env exactly, since that's how
# the backend connects to this same database.

DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=gestionventes

# Your real domain once you have one pointed at this server (A record ->
# server IP). Caddy then automatically gets a free HTTPS certificate for it.
# Leave unset / commented out for local testing.
# DOMAIN=sales.yourbrand.com
